{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "builder",
  "model": "opencode/big-pickle",
  "plugins": [
    {
      "package": "./plugin",
      "options": {
        "defaultAgent": true,
        "selftest": true,
        "debug": true,
        "roles": {
          "advisor": "opencode/big-pickle",
          "skeptic": "opencode/big-pickle"
        }
      }
    }
  ]
}
